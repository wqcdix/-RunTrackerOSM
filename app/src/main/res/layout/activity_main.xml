<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#DDFFFFFF">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статус: ожидание"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Дистанция: 0.00 км"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Текущая скорость: 0.0 км/ч"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvAverageSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Средняя скорость: 0.0 км/ч"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvAltitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Высота: нет данных"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvElevationGain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Набор высоты: 0 м"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Координаты: нет данных"
            android:textColor="#000000"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#DDFFFFFF">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Старт" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Стоп" />

    </LinearLayout>

</FrameLayout>
